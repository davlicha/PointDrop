# --- PostgreSQL Database ---
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=super_secret_db_password
POSTGRES_DB=pointdrop_db

# Connection string for Prisma and Backend
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Note: Use 'postgres' as host if running via docker-compose, or 'localhost' if running locally
DATABASE_URL=postgresql://postgres_user:super_secret_db_password@postgres:5432/pointdrop_db

# --- pgAdmin (Database Management UI) ---
PGADMIN_DEFAULT_EMAIL=admin@pointdrop.local
PGADMIN_DEFAULT_PASSWORD=pgadmin_secure_password

# --- Backend Configuration ---
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
SWAGGER_PATH=api/docs

# JWT Authentication
JWT_SECRET=your_very_secure_and_long_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# --- Frontend Configuration (for frontend/.env) ---
# If you are running frontend separately without docker, you might need these in frontend/.env
# VITE_API_URL=http://localhost:3000
# VITE_DEMO_SENDER_ID=some-uuid-here
# VITE_DEMO_MERCHANT_ID=some-uuid-here